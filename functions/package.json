{
  "name": "brain-math-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "golden": "tsc -p tsconfig.test.json && node .test-build/scripts/golden.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "npm run build && firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3"
  }
}
